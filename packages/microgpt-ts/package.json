{
  "name": "microgpt-ts",
  "version": "0.0.0",
  "description": "Réimplémentation TypeScript, fonctionnelle et vulgarisée, du microgpt de A. Karpathy.",
  "homepage": "https://github.com/ltruchot/butterfly-gpt#readme",
  "bugs": {
    "url": "https://github.com/ltruchot/butterfly-gpt/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Loïc Truchot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltruchot/butterfly-gpt.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./adam": "./dist/adam.mjs",
    "./attention": "./dist/attention.mjs",
    "./autograd": "./dist/autograd.mjs",
    "./dataset": "./dist/dataset.mjs",
    "./embeddings": "./dist/embeddings.mjs",
    "./loss": "./dist/loss.mjs",
    "./mlp": "./dist/mlp.mjs",
    "./model": "./dist/model.mjs",
    "./parameters": "./dist/parameters.mjs",
    "./rmsnorm": "./dist/rmsnorm.mjs",
    "./sample": "./dist/sample.mjs",
    "./tokenizer": "./dist/tokenizer.mjs",
    "./train": "./dist/train.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "train": "node src/microgpt.ts",
    "infer": "node src/microgpt.ts",
    "infer:hard": "MICROGPT_HARD=1 node src/microgpt.ts",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "bumpp": "11.0.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
